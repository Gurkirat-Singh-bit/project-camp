# Local development only.
POSTGRES_USER=project_camp
POSTGRES_PASSWORD=project_camp
POSTGRES_DB=project_camp
POSTGRES_PORT=5432
API_PORT=3001
WEB_PORT=3000

# Update this when changing the credentials, database name, or port.
DATABASE_URL=postgres://project_camp:project_camp@127.0.0.1:5432/project_camp

# Compose configures the API's database URL with the postgres service hostname.
# The DATABASE_URL above is for database commands run on your host.
